# ─── EcoChain Hardhat Environment Example ─────────────────────────────
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env`. The private key is a SECRET.

# ─── Sepolia RPC ──────────────────────────────────────────────────────
RPC_URL=https://ethereum-sepolia.publicnode.com

# ─── Deployer Wallet Private Key ──────────────────────────────────────
# THIS IS A SECRET. Never commit it. Use a dedicated deploy account with
# a small amount of testnet ETH only, never a production wallet.
# Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
PRIVATE_KEY=replace-with-a-dedicated-testnet-deployer-private-key

# ─── Role recipients (read by scripts/deploy.js) ──────────────────────
# The deployer hands every privileged role to these addresses and then steps
# down. Leave a value empty to give that role to the deployer (fine for a
# throwaway local node, NOT recommended on Sepolia).
#
# ADMIN    DEFAULT_ADMIN_ROLE on EcoToken, EcoChainTree and ReplantationRegistry.
#          A Gnosis Safe / multisig address is supported.
# VERIFIER VERIFIER_ROLE on EcoChainTree (and therefore the ability to verify
#          trees, confirm cuts and mark replacements).
# PAUSER   PAUSER_ROLE on EcoToken (defaults to ADMIN).
# FREEZER  FREEZER_ROLE on EcoToken (defaults to ADMIN).
ADMIN=
VERIFIER=
PAUSER=
FREEZER=

# ─── Explorer URL used in the printed environment block ───────────────
VITE_EXPLORER_URL=https://sepolia.etherscan.io
