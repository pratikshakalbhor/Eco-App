# ─── EcoChain Frontend Environment Example ────────────────────────────
# Copy this file to `.env.local` (or `.env`) and fill in real values.
# NEVER commit the real `.env`. NEVER put server-side secrets here.
# IMPORTANT: Do NOT add Pinata API key/secret/JWT here — those are
# server-side credentials and must live only in the backend.

# ─── Backend API URL ──────────────────────────────────────────────────
# Development:
VITE_API_URL=http://localhost:8080
# Production (set to your deployed backend URL, e.g.):
# VITE_API_URL=https://your-backend.onrender.com

# ─── Deployed Sepolia Contract Addresses (canonical names) ────────────
# One variable per deployed contract.
VITE_ECO_TOKEN=0x0000000000000000000000000000000000000000
VITE_ECO_CHAIN_TREE=0x0000000000000000000000000000000000000000
VITE_TREE_CUTTING_REPORT=0x0000000000000000000000000000000000000000
VITE_REPLANTATION_REGISTRY=0x0000000000000000000000000000000000000000

# ─── Sepolia Network ─────────────────────────────────────────────────
VITE_CHAIN_ID=11155111
VITE_CHAIN_NAME=Sepolia
VITE_RPC_URL=https://rpc.sepolia.org
VITE_EXPLORER_URL=https://sepolia.etherscan.io

# ─── Platform Wallet (receives marketplace payments) ──────────────────
# Public receive address for the platform. NOT a secret.
VITE_PLATFORM_WALLET=0x0000000000000000000000000000000000000000
