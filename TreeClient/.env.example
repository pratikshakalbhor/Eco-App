# ─── EcoChain Frontend Environment Example ────────────────────────────
# Copy this file to `.env.local` (or `.env`) and fill in real values.
# NEVER commit the real `.env`. NEVER put server-side secrets here.
# IMPORTANT: Do NOT add Pinata API key/secret/JWT here — those are
# server-side credentials and must live only in the backend.

# ─── Backend API URL ──────────────────────────────────────────────────
# Development:
VITE_API_URL=http://localhost:8080
# Production (set to your deployed backend URL, e.g.):
# VITE_API_URL=https://your-backend.onrender.com

# ─── Deployed Sepolia Contract Addresses (canonical names) ────────────
# One variable per deployed contract. These are the verified deployments from
# blockchain/deploy_log.txt (verified live via eth_getCode on Sepolia).
VITE_ECO_TOKEN=0x7a32EF8B84FBdcEd3D29730E1fc8702B1Ba93412
VITE_ECO_CHAIN_TREE=0xF0fccfa6B6f7aCaEC8276CABc4aA3DE40Cc72D4A
VITE_TREE_CUTTING_REPORT=0x32222027975C574e0970636970aB2fbA420f993C
VITE_REPLANTATION_REGISTRY=0xFB381D22511f006AAC76A20a6E8683Fb6BE19EA6

# ─── Sepolia Network ─────────────────────────────────────────────────
VITE_CHAIN_ID=11155111
VITE_CHAIN_NAME=Sepolia
VITE_RPC_URL=https://ethereum-sepolia.publicnode.com
VITE_EXPLORER_URL=https://sepolia.etherscan.io

# ─── Platform Wallet (receives marketplace payments) ──────────────────
# Public receive address for the platform. NOT a secret. MUST match the
# backend's PLATFORM_WALLET. Leave empty until you have a real receive
# address: the frontend refuses to send a payment to an empty or zero
# address, so an unconfigured build fails safely instead of burning funds.
VITE_PLATFORM_WALLET=
