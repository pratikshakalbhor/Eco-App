# ─── EcoChain Backend Environment Example ─────────────────────────────
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file. The real values are SECRETS.

# ─── Supabase / PostgreSQL (connection pool) ───────────────────────────
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_USER=postgres.<project-ref>
DB_PASSWORD=change-me-strong-database-password
DB_NAME=postgres
DB_PORT=6543
DB_SSLMODE=require

# ─── JWT ──────────────────────────────────────────────────────────────
# Generate a long random secret. NEVER reuse the example value.
# Example: openssl rand -hex 64
JWT_SECRET=replace-with-a-long-random-secret

# ─── Pinata (IPFS) ────────────────────────────────────────────────────
# These are SERVER-SIDE credentials. They must NEVER be exposed to the
# browser. Use either PINATA_JWT OR the API key/secret pair.
PINATA_JWT=replace-with-your-pinata-jwt
PINATA_API_KEY=replace-with-your-pinata-api-key
PINATA_SECRET_KEY=replace-with-your-pinata-secret-key

# ─── CORS / Allowed Origins (comma-separated) ─────────────────────────
# Include your local dev origins AND your production frontend origin(s).
# No wildcard "*". Authenticated requests require explicit origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app

# ─── Server ───────────────────────────────────────────────────────────
PORT=8080

# ─── Blockchain verification ──────────────────────────────────────────
# Public EVM RPC endpoint used to verify on-chain transactions
# (marketplace payments and tree-verification receipts).
RPC_URL=https://ethereum-sepolia.publicnode.com

# Wallet that receives marketplace payments. The frontend obtains this address
# from GET /api/marketplace/payment-config, so it must only be configured here.
# If this is empty the marketplace purchase endpoint refuses to settle — it
# never falls back to trusting the client's transaction hash.
PLATFORM_WALLET=0x0000000000000000000000000000000000000000

# Server-side price of one ETH in INR.
#
# The backend recomputes the minimum payment from this rate; the client's
# claimed ETH amount and exchange rate are never used. The endpoint refuses to
# settle if the rate is missing, unparseable or outside [1000, 100000000].
#
# NOTE: this is a static operator-supplied rate, which is adequate for a
# testnet deployment but will go stale. Replace it with a real price feed
# before running anything with value (see SECURITY.md).
ETH_INR_RATE=320000

# ─── Carbon credit model ──────────────────────────────────────────────
# kg of CO2e represented by one carbon credit. A tree is issued
# credits for the CO2 it has sequestered to date (rate * age) / this value.
# Default 1000 (1 credit = 1 tonne CO2e).
CARBON_KG_PER_CREDIT=1000
