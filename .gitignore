Backend/*.db

# --- Blockchain (blockchain) ---
blockchain/node_modules/
blockchain/artifacts/
blockchain/cache/
blockchain/typechain/
blockchain/typechain-types/
blockchain/gas-report.txt
blockchain/coverage.json
blockchain/slither-report.txt
# Deployment records contain live addresses but no secrets. Keep the JSON
# out of git (they are network-specific) while committing the README that
# explains the format and links the addresses to a block explorer.
blockchain/deployments/*.json
!blockchain/deployments/README.md
blockchain/.env
blockchain/.env.*
!blockchain/.env.example

